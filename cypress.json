{
    "baseUrl": "http://localhost:3000",
    "video": false,
    "screenshotOnRunFailure": true,
    "defaultCommandTimeout": 10000,
    "viewportWidth": 1280,
    "viewportHeight": 720,
    "retries": {
        "runMode": 2,
        "openMode": 0
    },
    "e2e": {
        "specPattern": "tests/e2e/**/*.cy.{js,jsx,ts,tsx}"
    },
    "component": {
        "specPattern": "**/*.cy.{js,jsx,ts,tsx}"
    }
}
